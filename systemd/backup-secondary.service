[Unit]
Description=Backup SECONDARY → DATA-SLOW
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/backup-sync backup-secondary /mnt/SECONDARY/ /mnt/DATA-SLOW/BACKUP/SECONDARY/ %h/.config/backup-sync/backup-secondary.exclude 60
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target

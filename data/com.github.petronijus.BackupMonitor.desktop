[Desktop Entry]
Name=Backup Monitor
Comment=Monitor and manage rsync backups
Exec=bash -c 'PYTHONPATH="$HOME/Documents/Dev/Backup-monitor/src:$PYTHONPATH" python3 -m backup_monitor.main'
Icon=drive-harddisk-symbolic
Terminal=false
Type=Application
Categories=Utility;System;
Keywords=backup;rsync;sync;monitor;
StartupNotify=true

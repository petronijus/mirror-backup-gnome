[Desktop Entry]
Name=Mirror Backup for GNOME
Comment=Monitor and manage rsync backups
Exec=bash -c 'EXT="$HOME/.local/share/gnome-shell/extensions/backup-monitor@petronijus"; PYTHONPATH="$EXT/app:${PYTHONPATH:-}" exec python3 -m backup_monitor.main'
Icon=drive-harddisk-symbolic
Terminal=false
Type=Application
Categories=Utility;System;
Keywords=backup;rsync;sync;monitor;
StartupNotify=true

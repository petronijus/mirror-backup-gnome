#!/usr/bin/env bash
# backup-sync — rsync wrapper with progress tracking and desktop notifications
# Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]

set -euo pipefail

JOB_NAME="${1:?Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]}"
SRC="${2:?Missing source path}"
DST="${3:?Missing destination path}"
EXCLUDE_FILE="${4:-}"
ARCHIVE_DAYS="${5:-0}"

STATUS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/backup-sync/status"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/backup-sync/logs"
mkdir -p "$STATUS_DIR" "$LOG_DIR"

STATUS_FILE="$STATUS_DIR/$JOB_NAME.json"
PID_FILE="$STATUS_DIR/$JOB_NAME.pid"
LOG_FILE="$LOG_DIR/$JOB_NAME.log"

RSYNC_PID=""
LAST_PCT=0
LAST_SPEED=""
LAST_ETA=""
FINISHED=0
START_TIME="$(date -Iseconds)"

# --- helpers ---

write_status() {
    local state="$1" pct="${2:-$LAST_PCT}" speed="${3:-$LAST_SPEED}" eta="${4:-$LAST_ETA}"
    cat > "$STATUS_FILE" <<-JEOF
{
  "job": "$JOB_NAME",
  "state": "$state",
  "progress": $pct,
  "speed": "$speed",
  "eta": "$eta",
  "pid": $$,
  "rsync_pid": ${RSYNC_PID:-0},
  "started": "$START_TIME",
  "updated": "$(date -Iseconds)",
  "src": "$SRC",
  "dst": "$DST"
}
JEOF
}

notify() {
    gdbus call --session \
        --dest=org.freedesktop.Notifications \
        --object-path=/org/freedesktop/Notifications \
        --method=org.freedesktop.Notifications.Notify \
        "Backup Sync" 0 "drive-harddisk" "$1" "$2" '[]' '{}' 5000 \
        >/dev/null 2>&1 || true
}

# --- signal handlers ---

pause_handler() {
    if [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null; then
        kill -STOP "$RSYNC_PID" 2>/dev/null || true
        write_status "paused"
        notify "⏸ $JOB_NAME" "Backup paused"
    fi
}

resume_handler() {
    if [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null; then
        kill -CONT "$RSYNC_PID" 2>/dev/null || true
        write_status "running"
        notify "▶ $JOB_NAME" "Backup resumed"
    fi
}

cleanup() {
    rm -f "$PID_FILE"
    if [[ "$FINISHED" -eq 0 ]]; then
        write_status "error"
        notify "✖ $JOB_NAME" "Backup failed or interrupted"
    fi
}

trap pause_handler SIGUSR1
trap resume_handler SIGUSR2
trap cleanup EXIT

# --- preflight checks ---

if [[ ! -d "$SRC" ]]; then
    write_status "error"
    notify "✖ $JOB_NAME" "Source not found: $SRC"
    FINISHED=1
    exit 1
fi

if [[ ! -d "$DST" ]]; then
    mkdir -p "$DST"
fi

# --- build rsync args ---

RSYNC_ARGS=(
    -a
    --delete
    --info=progress2
    --no-inc-recursive
    --human-readable
    --outbuf=L
)

if [[ -n "$EXCLUDE_FILE" && -f "$EXCLUDE_FILE" ]]; then
    RSYNC_ARGS+=(--exclude-from="$EXCLUDE_FILE")
fi

if [[ "$ARCHIVE_DAYS" -gt 0 ]]; then
    ARCHIVE_DIR="$DST/.archive/$(date +%Y-%m-%d_%H%M%S)"
    RSYNC_ARGS+=(--backup "--backup-dir=$ARCHIVE_DIR")
fi

# --- rotate log ---

if [[ -f "$LOG_FILE" ]] && (( $(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0) > 16777216 )); then
    mv -f "$LOG_FILE" "$LOG_FILE.prev"
fi

# --- go ---

echo "$$ " > "$PID_FILE"
write_status "running" 0
notify "🔄 $JOB_NAME" "$SRC → $DST"

echo "=== $(date -Iseconds) === $JOB_NAME: $SRC → $DST ===" >> "$LOG_FILE"

# Run rsync in background so we can capture its PID
rsync "${RSYNC_ARGS[@]}" "$SRC" "$DST" 2>> "$LOG_FILE" &
RSYNC_PID=$!
echo "$$ $RSYNC_PID" > "$PID_FILE"
write_status "running" 0

# Monitor /proc/RSYNC_PID/io for progress (bytes written vs source size)
# Fall back to waiting if /proc isn't available
if [[ -r "/proc/$RSYNC_PID/io" ]]; then
    # Get source size for progress estimation
    SRC_BYTES=$(du -sb "$SRC" 2>/dev/null | cut -f1 || echo 0)

    while kill -0 "$RSYNC_PID" 2>/dev/null; do
        if [[ -r "/proc/$RSYNC_PID/io" ]]; then
            WRITTEN=$(awk '/^write_bytes:/ {print $2}' "/proc/$RSYNC_PID/io" 2>/dev/null || echo 0)
            if [[ "$SRC_BYTES" -gt 0 && "$WRITTEN" -gt 0 ]]; then
                PCT=$(( WRITTEN * 100 / SRC_BYTES ))
                [[ "$PCT" -gt 100 ]] && PCT=100
                LAST_PCT=$PCT

                # Calculate speed (bytes since last check)
                if [[ -n "${PREV_WRITTEN:-}" && -n "${PREV_TIME:-}" ]]; then
                    NOW=$(date +%s%N)
                    ELAPSED_NS=$(( NOW - PREV_TIME ))
                    if [[ "$ELAPSED_NS" -gt 0 ]]; then
                        BPS=$(( (WRITTEN - PREV_WRITTEN) * 1000000000 / ELAPSED_NS ))
                        if (( BPS > 1073741824 )); then
                            LAST_SPEED="$(echo "scale=1; $BPS/1073741824" | bc)GB/s"
                        elif (( BPS > 1048576 )); then
                            LAST_SPEED="$(echo "scale=1; $BPS/1048576" | bc)MB/s"
                        elif (( BPS > 1024 )); then
                            LAST_SPEED="$(echo "scale=1; $BPS/1024" | bc)KB/s"
                        else
                            LAST_SPEED="${BPS}B/s"
                        fi

                        # ETA
                        REMAINING=$(( SRC_BYTES - WRITTEN ))
                        if [[ "$BPS" -gt 0 ]]; then
                            ETA_SECS=$(( REMAINING / BPS ))
                            LAST_ETA="$(printf '%d:%02d:%02d' $((ETA_SECS/3600)) $(((ETA_SECS%3600)/60)) $((ETA_SECS%60)))"
                        fi
                    fi
                fi
                PREV_WRITTEN=$WRITTEN
                PREV_TIME=$(date +%s%N)

                write_status "running" "$LAST_PCT" "$LAST_SPEED" "$LAST_ETA"
            fi
        fi
        sleep 2
    done
else
    wait "$RSYNC_PID" || true
fi

wait "$RSYNC_PID" 2>/dev/null
RSYNC_EXIT=$?

# --- archive cleanup ---

if [[ "$ARCHIVE_DAYS" -gt 0 && -d "$DST/.archive" ]]; then
    find "$DST/.archive" -maxdepth 1 -type d -mtime "+$ARCHIVE_DAYS" -exec rm -rf {} + 2>/dev/null || true
    # Remove .archive dir if empty
    rmdir "$DST/.archive" 2>/dev/null || true
fi

# --- finish ---

FINISHED=1
if [[ "$RSYNC_EXIT" -eq 0 ]]; then
    write_status "idle" 100
    notify "✔ $JOB_NAME" "Backup completed"
else
    write_status "error" "$LAST_PCT"
    notify "✖ $JOB_NAME" "Backup failed (exit $RSYNC_EXIT)"
fi

echo "=== $(date -Iseconds) === finished (exit $RSYNC_EXIT) ===" >> "$LOG_FILE"
exit "$RSYNC_EXIT"

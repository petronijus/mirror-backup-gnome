# backup-fun: F:\ (FUN) → Z:\BACKUP\FUN\
# Ported from BvckUp2 backup-0003

# User-defined excludes
.dropbox.device
.GamingRoot
$RECYCLE.BIN
AdobeCache
Games
GDrive
System Volume Information
WindowsApps

# System
Recycler
.dropbox.cache

# Temp & cache
*.tmp
~*.tmp
hiberfil.sys
pagefile.sys
swapfile.sys
found.???
.tickle
$dcsys$
.bzvol
Temporary Internet Files
CryptNetUrlCache
IconCacheToDelete

# Browser caches
Mozilla/Firefox/Profiles/*/Cache*
Google/Chrome/User Data/*/Cache
Microsoft/Edge/User Data/*/**Cache*
Microsoft/Internet Explorer/Recovery
Microsoft/Windows/INetCache
